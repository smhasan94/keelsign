/*
 * keelsign_hello partitions on nrf52840dk/nrf52840 (SHA-62, docs/mcuboot.md#partitions):
 * a 64 KB boot partition (MCUboot plus keelsign's LMS/HSS verifier; the board's default
 * is 48 KB), two 464 KB image slots, the 32 KB storage partition unchanged. The MCUboot
 * image includes this file from sysbuild/mcuboot.overlay, so both images always agree.
 *
 * SPDX-License-Identifier: MIT OR Apache-2.0
 */

/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;

&flash0 {
	partitions {
		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 0x00010000>;
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00010000 0x00074000>;
		};

		slot1_partition: partition@84000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00084000 0x00074000>;
		};
	};
};
